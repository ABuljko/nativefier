{
  "extends": "../tsconfig-base.json",
  "compilerOptions": {
    "outDir": "./dist",
    // The app runs on the Node bundled with Electron, not the CLI's Node. Stay
    // conservative for apps built with an older --electron-version: es2022 needs
    // Node 16.11+, i.e. Electron 17+.
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ]
  },
  "include": [
    "./src/**/*"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
